<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container">
  <!-- Player Selector (only visible for coaches/admins) -->
  <% if current_user.role == "coach" || current_user.role == "admin" %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card main-card p-4">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="text-white mb-0">Select Player</h5>
            <select id="playerSelector" class="form-select" style="width: auto; background-color: #2a2a2a; color: white; border-color: #666;">
              <% @players.each do |player_match| %>
                <option value="<%= player_match.id %>" <%= 'selected' if player_match == @player_match %>>
                  <%= player_match.player.name %> (<%= player_match.player.team.name %>)
                </option>
              <% end %>
            </select>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row g-4">
    <!-- Profile Card -->
    <div class="col-md-4">
      <div class="card main-card p-3 h-100">

        <!-- Radar Chart -->
        <div class="mb-4">
          <div class="card chart-card">
            <canvas id="radarChart" width="400" height="400"></canvas>
          </div>
        </div>

        <!-- Performance Categories -->
        <div class="mb-3">
          <div class="table-responsive">
            <table class="table table-dark table-sm mb-0">
              <thead class="bg-danger">
                <tr>
                  <th class="text-white fw-bold px-3 py-2">Category</th>
                  <th class="text-white fw-bold px-3 py-2 text-center">Player</th>
                  <th class="text-white fw-bold px-3 py-2 text-center">Team Avg</th>
                </tr>
              </thead>
              <tbody>
                <%
                  # Use controller data for consistency with radar chart
                  categories_data = [
                    ["Attack", @radar_player_data[:attack], @radar_team_data[:attack]],
                    ["Defense", @radar_player_data[:defense], @radar_team_data[:defense]],
                    ["Discipline", @radar_player_data[:discipline], @radar_team_data[:discipline]],
                    ["Work Rate", @radar_player_data[:work_rate], @radar_team_data[:work_rate]],
                    ["Skills", @radar_player_data[:skills], @radar_team_data[:skills]],
                    ["Consistency", @radar_player_data[:consistency], @radar_team_data[:consistency]]
                  ]

                  categories_data.each do |category, player_value, team_avg|
                    is_better = player_value > team_avg
                    arrow = is_better ? "↑" : "↓"
                    arrow_color = is_better ? "text-success" : "text-danger"
                %>
                  <tr class="border-secondary">
                    <td class="text-white px-3 py-2 small"><%= category %></td>
                    <td class="text-center px-3 py-2">
                      <span class="text-white fw-bold small"><%= player_value %></span>
                      <span class="<%= arrow_color %> ms-1 small"><%= arrow %></span>
                    </td>
                    <td class="text-white text-center px-3 py-2 small"><%= team_avg %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <br>

        <!-- Advanced Performance Metrics -->
        <div class="mb-3">
          <h6 class="text-white text-center mb-3">Best Performance Metrics</h6>
          <div class="table-responsive">
            <table class="table table-dark table-sm mb-0">
              <thead class="bg-danger">
                <tr>
                  <th class="text-white fw-bold px-2 py-2 small">Metric</th>
                  <th class="text-white fw-bold px-2 py-2 text-center small">Player</th>
                  <th class="text-white fw-bold px-2 py-2 text-center small">Team Avg</th>
                  <th class="text-white fw-bold px-2 py-2 text-center small">+/-</th>
                </tr>
              </thead>
              <tbody>
                <%
                  # Calculate advanced metrics
                  total_tackles = (@player_match&.positive_tackle || 0) + (@player_match&.neutral_tackle || 0) + (@player_match&.negative_tackle || 0) + (@player_match&.assist_tackle || 0)
                  missed_tackles = @player_match&.missed_tackle || 0
                  tackle_success = total_tackles > 0 ? ((total_tackles.to_f / (total_tackles + missed_tackles)) * 100).round(1) : 0

                  total_carries = (@player_match&.positive_carry || 0) + (@player_match&.carries || 0)
                  carries_with_gain = @player_match&.positive_carry || 0
                  carry_success = total_carries > 0 ? ((carries_with_gain.to_f / total_carries) * 100).round(1) : 0

                  mod_plus = @player_match&.mod_game_plus || 0
                  mod_minus = @player_match&.mod_game_minus || 0
                  mod_total = mod_plus + mod_minus
                  mod_success = mod_total > 0 ? ((mod_plus.to_f / mod_total) * 100).round(1) : 0

                  # Tackle impact calculation (simplified)
                  tackle_impact = ((@player_match&.positive_tackle || 0) * 1.5 + (@player_match&.neutral_tackle || 0) * 1.0 + (@player_match&.negative_tackle || 0) * 0.3 + (@player_match&.assist_tackle || 0) * 0.8).round(1)

                  # Total actions for work rate
                  total_actions = total_carries + total_tackles + (@player_match&.turnover || 0) + mod_plus

                  # Use the calculated best metrics from controller
                  metrics = @best_5_metrics || []

                  metrics.each do |metric|
                    # Use the flipped difference for color (already calculated for sorting)
                    sorting_difference = metric[:difference]
                    diff_color = sorting_difference > 0 ? "text-success" : "text-danger"

                    # Format values based on metric format first
                    player_display = case metric[:format]
                                   when :percentage
                                     "#{metric[:player_value]}%"
                                   when :decimal
                                     metric[:player_value].to_s
                                   else
                                     metric[:player_value].to_i.to_s
                                   end

                    # Round team average for consistent display and calculation
                    rounded_team_avg = case metric[:format]
                                     when :percentage, :decimal
                                       metric[:team_avg]
                                     else
                                       metric[:team_avg].round(1)
                                     end

                    team_display = case metric[:format]
                                 when :percentage
                                   "#{rounded_team_avg}%"
                                 when :decimal
                                   rounded_team_avg.to_s
                                 else
                                   rounded_team_avg.to_s
                                 end

                    # Use the already calculated difference from controller (which handles inverse logic)
                    display_difference = sorting_difference
                    diff_sign = display_difference > 0 ? "+" : ""

                    diff_display = case metric[:format]
                                 when :percentage
                                   "#{diff_sign}#{display_difference.round(1)}%"
                                 else
                                   "#{diff_sign}#{display_difference.round(1)}"
                                 end
                %>
                  <tr class="border-secondary">
                    <td class="text-white px-2 py-1 small"><%= metric[:name] %></td>
                    <td class="text-white text-center px-2 py-1 small"><%= player_display %></td>
                    <td class="text-white text-center px-2 py-1 small"><%= team_display %></td>
                    <td class="<%= diff_color %> text-center px-2 py-1 small fw-bold">
                      <%= diff_display %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <br>

        <!-- Worst Performance Metrics -->
        <div class="mb-3">
          <h6 class="text-white text-center mb-3">Worst Performance Metrics</h6>
          <div class="table-responsive">
            <table class="table table-dark table-sm mb-0">
              <thead class="bg-danger">
                <tr>
                  <th class="text-white fw-bold px-2 py-2 small">Metric</th>
                  <th class="text-white fw-bold px-2 py-2 text-center small">Player</th>
                  <th class="text-white fw-bold px-2 py-2 text-center small">Team Avg</th>
                  <th class="text-white fw-bold px-2 py-2 text-center small">+/-</th>
                </tr>
              </thead>
              <tbody>
                <%
                  # Use the calculated worst metrics from controller
                  worst_metrics = @worst_5_metrics || []

                  worst_metrics.each do |metric|
                    # Use the flipped difference for color (already calculated for sorting)
                    sorting_difference = metric[:difference]
                    diff_color = sorting_difference > 0 ? "text-success" : "text-danger"

                    # Format values based on metric format first
                    player_display = case metric[:format]
                                   when :percentage
                                     "#{metric[:player_value]}%"
                                   when :decimal
                                     metric[:player_value].to_s
                                   else
                                     metric[:player_value].to_i.to_s
                                   end

                    # Round team average for consistent display and calculation
                    rounded_team_avg = case metric[:format]
                                     when :percentage, :decimal
                                       metric[:team_avg]
                                     else
                                       metric[:team_avg].round(1)
                                     end

                    team_display = case metric[:format]
                                 when :percentage
                                   "#{rounded_team_avg}%"
                                 when :decimal
                                   rounded_team_avg.to_s
                                 else
                                   rounded_team_avg.to_s
                                 end

                    # For worst metrics, show absolute difference with + sign (how much worse)
                    display_difference = sorting_difference.abs
                    diff_sign = "+"

                    diff_display = case metric[:format]
                                 when :percentage
                                   "#{diff_sign}#{display_difference.round(1)}%"
                                 else
                                   "#{diff_sign}#{display_difference.round(1)}"
                                 end
                %>
                  <tr class="border-secondary">
                    <td class="text-white px-2 py-1 small"><%= metric[:name] %></td>
                    <td class="text-white text-center px-2 py-1 small"><%= player_display %></td>
                    <td class="text-white text-center px-2 py-1 small"><%= team_display %></td>
                    <td class="<%= diff_color %> text-center px-2 py-1 small fw-bold">
                      <%= diff_display %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <br>
        <!-- Team Stats -->
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="h5 text-white mb-0">Top 5 Players</div>
              <div style="width: 45%;">
                <%= select_tag "stats_dropdown", options_for_select(@stats_dropdown_options, @stats_dropdown_options&.first&.last),
                    { class: "form-select form-select-sm", id: "stats_dropdown",
                      style: "background-color: #2a2a2a; color: white; border-color: #666; font-size: 0.875rem;",
                      onchange: "handleStatsDropdownChange(event)" } %>
              </div>
            </div>
            <div class="text-white" id="stats_container" style="min-height: 200px;">
              <!-- Content will be populated by JavaScript -->
            </div>
          </div>
      </div>

    <!-- Player Stats Section -->
    <div class="col-md-8">
      <div class="row g-4">
        <!-- Detailed Stats Table by Category -->
        <div class="col-12">
          <div class="card main-card p-0">
            <div class="table-responsive">
              <%
                # Define stats organized by category based on Python rating system
                # When stats appear in multiple categories, they're placed where they have negative impact
                stats_by_category = {
                  "Attack" => [
                    ["Tries", @player_match&.try || 0],
                    ["Assists", @player_match&.try_assist || 0],
                    ["Linebreak", @player_match&.linebreak || 0],
                    ["Linebreak Assists", @player_match&.linebreak_assists || 0],
                    ["Carries With Gain", @player_match&.positive_carry || 0],
                    ["Carries Without Gain", @player_match&.carries || 0],
                    ["Conversions Made", @player_match&.conversion || 0],
                    ["Conversions Missed", @player_match&.missed_conversion || 0],
                    ["Kicks Made", @player_match&.penalty_kick_goal || 0],
                    ["Kicks Missed", @player_match&.missed_penalty_kick_goals || 0],
                    ["Drops Made", @player_match&.drop_goal || 0],
                    ["Drops Missed", @player_match&.missed_drop_goals || 0],
                    ["Mod Game Plus", @player_match&.mod_game_plus || 0]
                  ],
                  "Defense" => [
                    ["Positive Tackles", @player_match&.positive_tackle || 0],
                    ["Neutral Tackles", @player_match&.neutral_tackle || 0],
                    ["Negative Tackles", @player_match&.negative_tackle || 0],
                    ["Assist Tackles", @player_match&.assist_tackle || 0],
                    ["Missed Tackles", @player_match&.missed_tackle || 0],
                    ["Turnovers Won", @player_match&.turnover || 0],
                    ["Lineout Steals", @player_match&.lineout_turnover || 0],
                    ["Aerial Duels Won", @player_match&.aerial_duel_won || 0],
                    ["Aerial Duels Lost", @player_match&.aerial_duel_lost || 0]
                  ],
                  "Skills" => [
                    ["Offloads Good", @player_match&.positive_offload || 0],
                    ["Offloads Bad", @player_match&.negative_offload || 0],
                    ["Lineouts w/ Jump", @player_match&.lineout_won_jump || 0],
                    ["Lineouts w/o Jump", @player_match&.lineout_won_no_jump || 0],
                    ["Lineout Intros Won", @player_match&.introduction_won || 0],
                    ["Lineout Intros Lost", @player_match&.introduction_lost || 0],
                    ["Scrum Dominant", @player_match&.scrum_dominant || 0]
                  ],
                  "Discipline" => [
                    ["Total Penalties", @player_match&.penalties_conceded || 0],
                    ["Offside Penalties", @player_match&.pen_offside || 0],
                    ["Ruck Penalties", @player_match&.pen_breakdown || 0],
                    ["Scrum Penalties", @player_match&.pen_scrum || 0],
                    ["Other Penalties", @player_match&.pen_others || 0],
                    ["Yellow Cards", @player_match&.yellow || 0],
                    ["Red Cards", @player_match&.red || 0],
                    ["Knock On", @player_match&.knock_on || 0],
                    ["Other Mistakes", @player_match&.other_mistakes || 0]
                  ],
                  "Work Rate" => [
                    ["Total Carries", (@player_match&.positive_carry || 0) + (@player_match&.carries || 0)],
                    ["Total Tackles", (@player_match&.positive_tackle || 0) + (@player_match&.neutral_tackle || 0) + (@player_match&.negative_tackle || 0) + (@player_match&.assist_tackle || 0)],
                    ["Mod Game Minus", @player_match&.mod_game_minus || 0]
                  ],
                  "Consistency" => [
                    ["Time Played", @player_match&.time_played || 0],
                    ["Conversions Attempted", (@player_match&.conversion || 0) + (@player_match&.missed_conversion || 0)],
                    ["Kicks Attempted", (@player_match&.penalty_kick_goal || 0) + (@player_match&.missed_penalty_kick_goals || 0)],
                    ["Drops Attempted", (@player_match&.drop_goal || 0) + (@player_match&.missed_drop_goals || 0)],
                    ["Lineout Intros Total", (@player_match&.introduction_won || 0) + (@player_match&.introduction_lost || 0)],
                    ["Total Offloads", (@player_match&.positive_offload || 0) + (@player_match&.negative_offload || 0)],
                    ["Total Aerial Duels", (@player_match&.aerial_duel_won || 0) + (@player_match&.aerial_duel_lost || 0)],
                    ["Total Mod Game", (@player_match&.mod_game_plus || 0) + (@player_match&.mod_game_minus || 0)]
                  ]
                }

                # Display each category
                stats_by_category.each do |category, stats|
              %>
                <table class="table table-dark mb-3">
                  <thead class="bg-danger">
                    <tr>
                      <th colspan="6" class="text-white fw-bold px-3 py-3 text-center fs-5"><%= category %></th>
                    </tr>
                    <tr>
                      <th class="text-white fw-bold px-3 py-2">Stat</th>
                      <th class="text-white fw-bold px-3 py-2 text-center">Total</th>
                      <th class="text-white fw-bold px-3 py-2">Stat</th>
                      <th class="text-white fw-bold px-3 py-2 text-center">Total</th>
                      <th class="text-white fw-bold px-3 py-2">Stat</th>
                      <th class="text-white fw-bold px-3 py-2 text-center">Total</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%
                      # Split stats into three columns
                      stats_per_column = (stats.length / 3.0).ceil
                      stats_column_1 = stats[0, stats_per_column] || []
                      stats_column_2 = stats[stats_per_column, stats_per_column] || []
                      stats_column_3 = stats[stats_per_column * 2, stats_per_column] || []

                      # Create rows by combining the three columns
                      max_rows = [stats_column_1.length, stats_column_2.length, stats_column_3.length].max
                      (0...max_rows).each do |i|
                        stat1 = stats_column_1[i] || ["", ""]
                        stat2 = stats_column_2[i] || ["", ""]
                        stat3 = stats_column_3[i] || ["", ""]
                    %>
                      <tr class="border-secondary">
                        <td class="text-white px-3 py-2"><%= stat1[0] %></td>
                        <td class="text-white text-center px-3 py-2"><%= stat1[1] %></td>
                        <td class="text-white px-3 py-2"><%= stat2[0] %></td>
                        <td class="text-white text-center px-3 py-2"><%= stat2[1] %></td>
                        <td class="text-white px-3 py-2"><%= stat3[0] %></td>
                        <td class="text-white text-center px-3 py-2"><%= stat3[1] %></td>
                      </tr>
                <% end %>
                  </tbody>
                </table>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <br>
  <br>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const ctx = document.getElementById('radarChart').getContext('2d');

    // Debug output
    console.log("Radar Player Data:", [<%= @radar_player_data[:attack] %>, <%= @radar_player_data[:defense] %>, <%= @radar_player_data[:discipline] %>, <%= @radar_player_data[:work_rate] %>, <%= @radar_player_data[:skills] %>, <%= @radar_player_data[:consistency] %>]);
    console.log("Radar Team Data:", [<%= @radar_team_data[:attack] %>, <%= @radar_team_data[:defense] %>, <%= @radar_team_data[:discipline] %>, <%= @radar_team_data[:work_rate] %>, <%= @radar_team_data[:skills] %>, <%= @radar_team_data[:consistency] %>]);

    const radarChart = new Chart(ctx, {
      type: 'radar',
      data: {
        labels: ["Attack", "Defense", "Discipline", "Work Rate", "Skills", "Consistency"],
        datasets: [{
          label: "This Game",
          data: [<%= @radar_player_data[:attack] %>, <%= @radar_player_data[:defense] %>, <%= @radar_player_data[:discipline] %>, <%= @radar_player_data[:work_rate] %>, <%= @radar_player_data[:skills] %>, <%= @radar_player_data[:consistency] %>],
          fill: true,
          backgroundColor: '#4dc9f67a',
          borderColor: '#4dc9f6',
          pointBackgroundColor: '#4dc9f6'
        },
        {
          label: "Team Average",
          data: [<%= @radar_team_data[:attack] %>, <%= @radar_team_data[:defense] %>, <%= @radar_team_data[:discipline] %>, <%= @radar_team_data[:work_rate] %>, <%= @radar_team_data[:skills] %>, <%= @radar_team_data[:consistency] %>],
          fill: true,
          backgroundColor: '#f725857a',
          borderColor: '#f72585',
          pointBackgroundColor: '#f72585'
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            display: true,
            labels: {
              color: 'white'
            }
          },
          tooltip: {
            enabled: true
          },
          labels: {
            color: 'white'
          }
        },
        scales: {
          r: {
            min: 0,
            max: 10,
            angleLines: {
              color: '#ccc'
            },
            grid: {
              color: '#666'
            },
            pointLabels: {
              color: '#eee'
            },
            ticks: {
              display: false
            }
          }
        }
      }
    });

    // Handle player selection changes (for coaches/admins)
    const playerSelector = document.getElementById('playerSelector');
    if (playerSelector) {
      playerSelector.addEventListener('change', function() {
        const playerMatchId = this.value;

        // Make AJAX request to get updated player data
        fetch(`/matches/<%= @match.id %>/player_data?player_match_id=${playerMatchId}`, {
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
        .then(response => response.json())
        .then(data => {
          // Update radar chart
          updateRadarChart(data.radar_player_data, data.radar_team_data);

          // Update performance metrics tables
          updatePerformanceMetrics(data.best_5_metrics, data.worst_5_metrics);

          // Update detailed stats tables
          updateDetailedStats(data.player_match);
        })
        .catch(error => {
          console.error('Error updating player stats:', error);
          // Fallback to page refresh if AJAX fails
          window.location.href = `/matches/<%= @match.id %>?player_match_id=${playerMatchId}`;
        });
      });
    }

    // Function to update radar chart with new data
    function updateRadarChart(playerData, teamData) {
      if (radarChart) {
        radarChart.data.datasets[0].data = [
          playerData.attack, playerData.defense, playerData.discipline,
          playerData.work_rate, playerData.skills, playerData.consistency
        ];
        radarChart.data.datasets[1].data = [
          teamData.attack, teamData.defense, teamData.discipline,
          teamData.work_rate, teamData.skills, teamData.consistency
        ];
        radarChart.update();
      }

      // Also update the category comparison table
      updateCategoryTable(playerData, teamData);
    }

    // Function to update performance metrics tables
    function updatePerformanceMetrics(bestMetrics, worstMetrics) {
      // Find tables by their headers
      const headers = document.querySelectorAll('h6');
      let bestTableBody = null;
      let worstTableBody = null;

      headers.forEach(header => {
        if (header.textContent.includes('Best Performance Metrics')) {
          bestTableBody = header.closest('.mb-3').querySelector('tbody');
        } else if (header.textContent.includes('Worst Performance Metrics')) {
          worstTableBody = header.closest('.mb-3').querySelector('tbody');
        }
      });

      if (bestTableBody && bestMetrics) {
        updateMetricsTable(bestTableBody, bestMetrics);
      }

      if (worstTableBody && worstMetrics) {
        updateMetricsTable(worstTableBody, worstMetrics);
      }
    }

    // Helper function to update metrics table
    function updateMetricsTable(tbody, metrics) {
      tbody.innerHTML = '';
      metrics.forEach(metric => {
        const row = document.createElement('tr');
        row.className = 'border-secondary';

        const playerDisplay = metric.format === 'percentage' ? `${metric.player_value}%` : metric.player_value.toString();
        const teamDisplay = metric.format === 'percentage' ? `${metric.team_avg}%` : metric.team_avg.toString();
        const diffColor = metric.difference > 0 ? 'text-success' : 'text-danger';
        const diffSign = metric.difference > 0 ? '+' : '';
        const diffDisplay = metric.format === 'percentage' ?
          `${diffSign}${metric.difference.toFixed(1)}%` :
          `${diffSign}${metric.difference.toFixed(1)}`;

        row.innerHTML = `
          <td class="text-white px-2 py-1 small">${metric.name}</td>
          <td class="text-white text-center px-2 py-1 small">${playerDisplay}</td>
          <td class="text-white text-center px-2 py-1 small">${teamDisplay}</td>
          <td class="${diffColor} text-center px-2 py-1 small fw-bold">${diffDisplay}</td>
        `;
        tbody.appendChild(row);
      });
    }

    // Function to update detailed stats tables
    function updateDetailedStats(playerMatch) {
      // Update all the stat values in the detailed tables
      const statMappings = {
        // Attack stats
        'Tries': playerMatch.try,
        'Assists': playerMatch.try_assist,
        'Linebreak': playerMatch.linebreak,
        'Linebreak Assists': playerMatch.linebreak_assists,
        'Carries With Gain': playerMatch.positive_carry,
        'Carries Without Gain': playerMatch.carries,
        'Conversions Made': playerMatch.conversion,
        'Conversions Missed': playerMatch.missed_conversion,
        'Kicks Made': playerMatch.penalty_kick_goal,
        'Kicks Missed': playerMatch.missed_penalty_kick_goals,
        'Drops Made': playerMatch.drop_goal,
        'Drops Missed': playerMatch.missed_drop_goals,
        'Mod Game Plus': playerMatch.mod_game_plus,
        // Defense stats
        'Positive Tackles': playerMatch.positive_tackle,
        'Neutral Tackles': playerMatch.neutral_tackle,
        'Negative Tackles': playerMatch.negative_tackle,
        'Assist Tackles': playerMatch.assist_tackle,
        'Missed Tackles': playerMatch.missed_tackle,
        'Turnovers Won': playerMatch.turnover,
        'Lineout Steals': playerMatch.lineout_turnover,
        'Aerial Duels Won': playerMatch.aerial_duel_won,
        'Aerial Duels Lost': playerMatch.aerial_duel_lost,
        // Skills stats
        'Offloads Good': playerMatch.positive_offload,
        'Offloads Bad': playerMatch.negative_offload,
        'Lineouts w/ Jump': playerMatch.lineout_won_jump,
        'Lineouts w/o Jump': playerMatch.lineout_won_no_jump,
        'Lineout Intros Won': playerMatch.introduction_won,
        'Lineout Intros Lost': playerMatch.introduction_lost,
        'Scrum Dominant': playerMatch.scrum_dominant,
        // Discipline stats
        'Total Penalties': playerMatch.penalties_conceded,
        'Offside Penalties': playerMatch.pen_offside,
        'Ruck Penalties': playerMatch.pen_breakdown,
        'Scrum Penalties': playerMatch.pen_scrum,
        'Other Penalties': playerMatch.pen_others,
        'Yellow Cards': playerMatch.yellow,
        'Red Cards': playerMatch.red,
        'Knock On': playerMatch.knock_on,
        'Other Mistakes': playerMatch.other_mistakes,
        // Work Rate stats
        'Total Carries': playerMatch.positive_carry + playerMatch.carries,
        'Total Tackles': playerMatch.positive_tackle + playerMatch.neutral_tackle + playerMatch.negative_tackle + playerMatch.assist_tackle,
        'Mod Game Minus': playerMatch.mod_game_minus,
        // Consistency stats
        'Time Played': playerMatch.time_played,
        'Conversions Attempted': playerMatch.conversion + playerMatch.missed_conversion,
        'Kicks Attempted': playerMatch.penalty_kick_goal + playerMatch.missed_penalty_kick_goals,
        'Drops Attempted': playerMatch.drop_goal + playerMatch.missed_drop_goals,
        'Lineout Intros Total': playerMatch.introduction_won + playerMatch.introduction_lost,
        'Total Offloads': playerMatch.positive_offload + playerMatch.negative_offload,
        'Total Aerial Duels': playerMatch.aerial_duel_won + playerMatch.aerial_duel_lost,
        'Total Mod Game': playerMatch.mod_game_plus + playerMatch.mod_game_minus
      };

      // Update each stat in the tables
      Object.entries(statMappings).forEach(([statName, value]) => {
        // Find all cells that contain this stat name and update the adjacent value cell
        const statCells = Array.from(document.querySelectorAll('td')).filter(td =>
          td.textContent.trim() === statName
        );

        statCells.forEach(cell => {
          const valueCell = cell.nextElementSibling;
          if (valueCell) {
            valueCell.textContent = value;
          }
        });
      });
    }

    // Function to update the category comparison table
    function updateCategoryTable(playerData, teamData) {
      const categories = [
        { name: 'Attack', player: playerData.attack, team: teamData.attack },
        { name: 'Defense', player: playerData.defense, team: teamData.defense },
        { name: 'Discipline', player: playerData.discipline, team: teamData.discipline },
        { name: 'Work Rate', player: playerData.work_rate, team: teamData.work_rate },
        { name: 'Skills', player: playerData.skills, team: teamData.skills },
        { name: 'Consistency', player: playerData.consistency, team: teamData.consistency }
      ];

      // Find the category table (it's the first table in the first card)
      const categoryTable = document.querySelector('.card.main-card .table tbody');
      if (categoryTable) {
        categoryTable.innerHTML = '';

        categories.forEach(category => {
          const row = document.createElement('tr');
          row.className = 'border-secondary';

          const isBetter = category.player > category.team;
          const arrow = isBetter ? '↑' : '↓';
          const arrowColor = isBetter ? 'text-success' : 'text-danger';

          row.innerHTML = `
            <td class="text-white px-3 py-2 small">${category.name}</td>
            <td class="text-center px-3 py-2">
              <span class="text-white fw-bold small">${category.player}</span>
              <span class="${arrowColor} ms-1 small">${arrow}</span>
            </td>
            <td class="text-white text-center px-3 py-2 small">${category.team}</td>
          `;
          categoryTable.appendChild(row);
        });
      }
    }

    // Stats dropdown functionality
    const statsData = <%= raw @stats_data.to_json %>;

    // Global function for handling dropdown changes (accessible to onchange attribute)
    window.handleStatsDropdownChange = function(event) {
      console.log('Dropdown changed to:', event.target.value);
      console.log('Available data keys:', Object.keys(statsData));
      updateStatsContainer(event.target.value);
    };

    function updateStatsContainer(statType) {
      console.log('updateStatsContainer called with:', statType);
      const container = document.getElementById('stats_container');
      if (!container) {
        console.error('Stats container not found');
        return;
      }

      const data = statsData[statType] || [];
      console.log('Data for', statType, ':', data);

      if (data.length === 0) {
        console.log('No data found for', statType);
        container.innerHTML = '<div class="text-center text-secondary mt-4"><i class="fas fa-chart-bar fa-2x mb-2"></i><p>No data available for ' + statType + '</p></div>';
        return;
      }

      // Sort data with tie-breaking: 1) by value (desc), 2) by minutes played (asc), 3) by name (asc)
      const sortedData = data.sort((a, b) => {
        // First sort by value (descending - higher is better)
        if (b.value !== a.value) {
          return b.value - a.value;
        }
        // If values are tied, sort by minutes played (ascending - fewer minutes wins)
        if (a.minutes_played !== b.minutes_played) {
          return a.minutes_played - b.minutes_played;
        }
        // If still tied, sort alphabetically by name for consistency
        return a.name.localeCompare(b.name);
      });

      // Create rankings with proper tie handling
      let currentRank = 1;
      let playersWithRanks = [];
      
      for (let i = 0; i < Math.min(sortedData.length, 5); i++) {
        const player = sortedData[i];
        
        // Check if this player is tied with the previous player
        if (i > 0) {
          const prevPlayer = sortedData[i - 1];
          if (player.value === prevPlayer.value && player.minutes_played === prevPlayer.minutes_played) {
            // Same rank as previous player (true tie)
            playersWithRanks.push({
              ...player,
              rank: playersWithRanks[i - 1].rank
            });
          } else {
            // New rank
            currentRank = i + 1;
            playersWithRanks.push({
              ...player,
              rank: currentRank
            });
          }
        } else {
          // First player
          playersWithRanks.push({
            ...player,
            rank: 1
          });
        }
      }

      // Create a clean list of top players for this stat
      let html = '<div class="stats-list mt-3">';
      playersWithRanks.forEach((player, index) => {
        const position = player.rank;
        const isTop3 = position <= 3;
        const positionClass = isTop3 ? 'text-warning fw-bold' : 'text-secondary';
        const nameClass = isTop3 ? 'text-white fw-bold' : 'text-white';
        const valueClass = isTop3 ? 'text-success fw-bold' : 'text-primary';

        html += `
          <div class="d-flex justify-content-between align-items-center py-2 px-3 mb-2 rounded border-secondary" style="background: linear-gradient(90deg, rgba(77, 201, 246, 0.1) 0%, rgba(0, 0, 0, 0.2) 100%); border: 1px solid rgba(255, 255, 255, 0.1);">
            <div class="d-flex align-items-center">
              <span class="${positionClass} me-3" style="min-width: 20px; font-size: 0.9rem;">#${position}</span>
              <div>
                <span class="${nameClass}" style="font-size: 0.9rem;">${player.name}</span>
                <div class="text-secondary" style="font-size: 0.75rem;">${player.minutes_played}' played</div>
              </div>
            </div>
            <span class="${valueClass}" style="font-size: 1rem;">${player.value}</span>
          </div>
        `;
      });
      html += '</div>';

      container.innerHTML = html;
    }

    // Initialize with first option
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Setting up stats dropdown...');
      const dropdown = document.getElementById('stats_dropdown');
      console.log('Dropdown element:', dropdown);

      if (dropdown) {
        // Remove any existing event listeners
        dropdown.removeEventListener('change', handleStatsDropdownChange);

        // Initialize with current dropdown value or first option
        const initialValue = dropdown.value || 'positive_tackles';
        console.log('Initial value:', initialValue);
        updateStatsContainer(initialValue);

        // Add event listener for dropdown changes
        dropdown.addEventListener('change', handleStatsDropdownChange);
        console.log('Event listener added to dropdown');
      }
    });

    // Also try to initialize after a short delay in case DOM isn't fully ready
    setTimeout(function() {
      const dropdown = document.getElementById('stats_dropdown');
      if (dropdown && dropdown.value) {
        console.log('Timeout initialization with:', dropdown.value);
        updateStatsContainer(dropdown.value);
      }
    }, 500);
  });
</script>
