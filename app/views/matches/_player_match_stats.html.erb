<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container">
  <div class="row g-4">
    <!-- Profile Card -->
    <div class="col-md-4">
      <div class="card main-card p-2 h-100 d-flex justify-content-center align-items-center">
        <!-- Overall Chart -->
        <div class="col-md-9">
          <div class="card chart-card h-100">
            <canvas id="radarChart" width="400" height="400"></canvas>
          </div>
        </div>
        <!-- General Info -->
        <div class="col-md-12">
          <div class="card chart-card p-4 h-100">
            <br>
            <ul class="list-unstyled stats-list">
              <li class="d-flex justify-content-center align-items-center mb-2">
                <h5 class="text-secondary">Best</h5>
              </li>
              <li class="d-flex justify-content-between align-items-center mb-2">
                <span>COMING SOON...</span>
                <%# <span class="stat-value">70% <span class="text-secondary">(4º)</span></span> %>
              </li>
              <li class="d-flex justify-content-center align-items-center mb-2">
                <h5 class="text-secondary">Worse</h5>
              </li>
              <li class="d-flex justify-content-between align-items-center mb-2">
                <span>COMING SOON...</span>
                <%# <span class="stat-value">3 <span class="text-secondary">(12º)</span></span> %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts and Stats -->
    <div class="col-md-8">
      <div class="row g-4">
        <!-- Performance Chart -->
        <div class="col-12">
          <div class="card card main-card p-4 mb-2">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="h5 text-white mb-0">Performance</div>
              <span class="text-secondary">2025/2026</span>
            </div>
            <div>
              <%= turbo_frame_tag "performance_chart" do %>
                <% if player.present? && current_user.role == "player" %>
                  <%= column_chart [
                      { name: player.name, data: @performance_data },
                      { name: "Team Average", data: @average_player_performance_data }
                    ],
                  height: "220px",
                  colors: ["#4dc9f6", "#f72585"],
                  library: {
                    plugins: {
                      tooltip: {
                        enabled: false
                      },
                      legend: {
                        labels: {
                          color: 'white'
                        }
                      }
                    },
                    scales: {
                      x: {
                        grid: {
                          color: 'rgba(255, 255, 255, 0.1)'
                        },
                        ticks: {
                          color: 'white'
                        }
                      },
                      y: {
                        grid: {
                          color: 'rgba(255, 255, 255, 0.1)'
                        },
                        ticks: {
                          color: 'white'
                        }
                      }
                    }
                  } %>
                <% else %>
                  <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No player data available. Please contact an administrator.
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- absolute stats -->
        <div class="col-md-6">
          <div class="card card main-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="h5 text-white mb-0">Stats</div>
              <div class="d-flex justify-content-end w-50">
                <%= select_tag "stats_dropdown", options_for_select(@stats_dropdown_options, @stats_dropdown_options&.first&.last),
                    { class: "form-select", id: "stats_dropdown" } %>
              </div>
            </div>
            <br>
            <div class="text-white" id="stats_container">
              <!-- Content will be populated by JavaScript -->
            </div>
          </div>
        </div>

        <!-- relative stats -->
        <div class="col-md-6">
          <div class="card card main-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="h5 text-white mb-0">Metrics</div>
              <div class="d-flex justify-content-end w-50">
                <%= select_tag "absolute_stats_dropdown", options_for_select(@metrics_dropdown_options), class: "form-select" %>
              </div>
            </div>
            <br>
            <div class="d-flex justify-content-between text-white">
              <ul class="list-unstyled">
                <li>COMING SOON...</li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
  <br>
  <br>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const ctx = document.getElementById('radarChart').getContext('2d');

    const radarChart = new Chart(ctx, {
      type: 'radar',
      data: {
        labels: ["Attack", "Defense", "Work Rate", "Discipline", "Skills", "Consistency"],
        datasets: [{
          label: "This Game",
          data: [<%= @player_match_performance_data["Attack"] %>, <%= @player_match_performance_data["Defense"] %>, <%= @player_match_performance_data["Work Rate"] %>, <%= @player_match_performance_data["Discipline"] %>, <%= @player_match_performance_data["Skills"] %>, <%= @player_match_performance_data["Consistency"] %>],
          fill: true,
          backgroundColor: '#4dc9f67a',
          borderColor: '#4dc9f6',
          pointBackgroundColor: '#4dc9f6'
        },
        {
          label: "Team Average",
          data: [<%= @player_season_average_performance_data["Attack"] %>, <%= @player_season_average_performance_data["Defense"] %>, <%= @player_season_average_performance_data["Work Rate"] %>, <%= @player_season_average_performance_data["Discipline"] %>, <%= @player_season_average_performance_data["Skills"] %>, <%= @player_season_average_performance_data["Consistency"] %>],
          fill: true,
          backgroundColor: '#f725857a',
          borderColor: '#f72585',
          pointBackgroundColor: '#f72585'
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            display: true,
            labels: {
              color: 'white'
            }
          },
          tooltip: {
            enabled: true
          },
          labels: {
            color: 'white'
          }
        },
        scales: {
          r: {
            min: 0,
            max: 10,
            angleLines: {
              color: '#ccc'
            },
            grid: {
              color: '#666'
            },
            pointLabels: {
              color: '#eee'
            },
            ticks: {
              display: false
            }
          }
        }
      }
    });

    // Stats dropdown functionality
    const statsData = <%= raw (@stats_data || {}).to_json %>;
    const statsDropdown = document.getElementById('stats_dropdown');
    const statsContainer = document.getElementById('stats_container');

    function updateStatsList(selectedStat) {
      const players = statsData[selectedStat] || [];

      if (!statsContainer) {
        console.error('Stats container not found');
        return;
      }

      // Clear existing content
      statsContainer.innerHTML = '';

      if (players.length === 0) {
        statsContainer.innerHTML = '<div class="text-muted">No data available</div>';
        return;
      }

      // Create stats list
      let html = '';
      players.forEach((player, index) => {
        html += `
          <div class="d-flex justify-content-between align-items-center mb-2 text-white">
            <span>${index + 1}º - ${player.name}</span>
            <span class="stat-value fw-bold">${player.value}</span>
          </div>
        `;
      });

      statsContainer.innerHTML = html;
    }

    // Initialize dropdown functionality
    if (statsDropdown && statsContainer) {
      // Initialize with first option
      let initialValue = statsDropdown.value;
      if (!initialValue && statsDropdown.options.length > 0) {
        initialValue = statsDropdown.options[0].value;
        statsDropdown.value = initialValue;
      }

      if (initialValue) {
        updateStatsList(initialValue);
      }

      // Handle dropdown changes
      statsDropdown.addEventListener('change', function() {
        updateStatsList(this.value);
      });
    }
  });
</script>
