<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container">
  <!-- Player Selector -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card main-card p-4">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">Select Player</h5>
          <select id="playerSelector" class="form-select" style="width: auto; background-color: #2a2a2a; color: white; border-color: #666;">
            <% (@players).each do |player| %>
              <option value="<%= player.id %>" <%= 'selected' if player == @players.first %>>
                <%= player.player.name %> (<%= player.player.team.name %>)
              </option>
            <% end %>
          </select>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Profile Card -->
    <div class="col-md-4">
      <div class="card main-card p-2 h-100 d-flex justify-content-center align-items-center">
        <!-- Overall Chart -->
        <div class="col-md-9">
          <div class="card chart-card h-100">
            <canvas id="radarChart" width="400" height="400"></canvas>
          </div>
        </div>
        <!-- General Info -->
        <div class="col-md-12">
          <div class="card chart-card p-4 h-100">
            <br>
            <ul class="list-unstyled stats-list">
              <li class="d-flex justify-content-center align-items-center mb-2">
                <h5 class="text-secondary">Best</h5>
              </li>
              <li class="d-flex justify-content-between align-items-center mb-2">
                <span>COMING SOON...</span>
              </li>
              <li class="d-flex justify-content-center align-items-center mb-2">
                <h5 class="text-secondary">Worse</h5>
              </li>
              <li class="d-flex justify-content-between align-items-center mb-2">
                <span>COMING SOON...</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts and Stats -->
    <div class="col-md-8">
      <div class="row g-4">
        <!-- Performance Chart -->
        <div class="col-12">
          <div class="card card main-card p-4 mb-2">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="h5 text-white mb-0">Performance</div>
              <span class="text-secondary">2025/2026</span>
            </div>
            <div id="performance-chart-container">
              <%= turbo_frame_tag "performance_chart" do %>
                <div id="chart-content">
                  <!-- Chart will be populated by JavaScript -->
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- absolute stats -->
        <div class="col-md-6">
          <div class="card card main-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="h5 text-white mb-0">Stats</div>
              <div class="d-flex justify-content-end w-50">
                <%= select_tag "stats_dropdown", options_for_select(@stats_dropdown_options, @stats_dropdown_options&.first&.last),
                    { class: "form-select", id: "stats_dropdown" } %>
              </div>
            </div>
            <br>
            <div class="text-white" id="stats_container">
              <!-- Content will be populated by JavaScript -->
            </div>
          </div>
        </div>

        <!-- relative stats -->
        <div class="col-md-6">
          <div class="card card main-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="h5 text-white mb-0">Metrics</div>
              <div class="d-flex justify-content-end w-50">
                <%= select_tag "metrics_dropdown", options_for_select(@metrics_dropdown_options), class: "form-select" %>
              </div>
            </div>
            <br>
            <div class="d-flex justify-content-between text-white">
              <ul class="list-unstyled">
                <li>COMING SOON...</li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
  <br>
  <br>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    let radarChart;
    let performanceChart;

    // Initialize with first player
    const playerSelector = document.getElementById('playerSelector');
    console.log('Player selector element:', playerSelector);
    const firstPlayerId = playerSelector ? playerSelector.value : null;
    console.log('First player ID:', firstPlayerId);

    if (firstPlayerId) {
      console.log('Calling updatePlayerStats with first player:', firstPlayerId);
      updatePlayerStats(firstPlayerId);
    } else {
      console.error('No first player ID found');
    }

    function initializeRadarChart(playerData, seasonData) {
      console.log('initializeRadarChart called');
      console.log('playerData:', playerData);
      console.log('seasonData:', seasonData);

      const radarChartElement = document.getElementById('radarChart');
      console.log('radarChart element:', radarChartElement);

      if (!radarChartElement) {
        console.error('radarChart element not found');
        return;
      }

      // Ensure canvas has proper dimensions
      radarChartElement.width = 400;
      radarChartElement.height = 400;
      radarChartElement.style.width = '400px';
      radarChartElement.style.height = '400px';
      console.log('Canvas dimensions set to:', radarChartElement.width, 'x', radarChartElement.height);
      console.log('Canvas style dimensions:', radarChartElement.style.width, 'x', radarChartElement.style.height);

      const ctx = radarChartElement.getContext('2d');
      console.log('Canvas context:', ctx);

      // Clear the canvas completely
      ctx.clearRect(0, 0, radarChartElement.width, radarChartElement.height);

      if (radarChart) {
        console.log('Destroying existing radar chart variable');
        radarChart.destroy();
        radarChart = null;
      }

      // Force Chart.js to forget about this canvas
      if (Chart.getChart(radarChartElement)) {
        console.log('Found existing Chart.js instance, destroying it');
        Chart.getChart(radarChartElement).destroy();
      }

      console.log('Creating new radar chart');
      try {
        radarChart = new Chart(ctx, {
          type: 'radar',
          data: {
            labels: ["Attack", "Defense", "Work Rate", "Discipline"],
            datasets: [{
              label: "This Game",
              data: [playerData["Attack"] || 0, playerData["Defense"] || 0, playerData["Work Rate"] || 0, playerData["Discipline"] || 0],
              fill: true,
              backgroundColor: '#4dc9f67a',
              borderColor: '#4dc9f6',
              pointBackgroundColor: '#4dc9f6'
            },
            {
              label: "Team Average",
              data: [seasonData["Attack"] || 0, seasonData["Defense"] || 0, seasonData["Work Rate"] || 0, seasonData["Discipline"] || 0],
              fill: true,
              backgroundColor: '#f725857a',
              borderColor: '#f72585',
              pointBackgroundColor: '#f72585'
            }]
          },
        options: {
          responsive: true,
          plugins: {
            legend: {
              display: true,
              labels: {
                color: 'white'
              }
            },
            tooltip: {
              enabled: true
            }
          },
          scales: {
            r: {
              min: 0,
              max: 10,
              angleLines: {
                color: '#ccc'
              },
              grid: {
                color: '#666'
              },
              pointLabels: {
                color: '#eee'
              },
              ticks: {
                display: false
              }
            }
          }
        }
      });
      console.log('Radar chart created successfully');
      console.log('Chart instance:', radarChart);
      console.log('Chart canvas dimensions after creation:', radarChart.canvas.width, 'x', radarChart.canvas.height);
      console.log('Chart canvas style dimensions after creation:', radarChart.canvas.style.width, 'x', radarChart.canvas.style.height);
      console.log('Chart canvas computed style:', window.getComputedStyle(radarChart.canvas).width, 'x', window.getComputedStyle(radarChart.canvas).height);
      } catch (error) {
        console.error('Error creating radar chart:', error);
      }
    }

    function updatePlayerStats(playerId) {
      console.log('updatePlayerStats called with playerId:', playerId);
      const url = `/matches/<%= @match.id %>/coach_player_stats?player_id=${playerId}`;
      console.log('Fetching from URL:', url);

      // Make AJAX request to get player stats
      fetch(url, {
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => {
        console.log('Response status:', response.status);
        console.log('Response ok:', response.ok);
        return response.json();
      })
      .then(data => {
        console.log('Received data:', data);

        // Update radar chart
        console.log('Updating radar chart with:', data.player_match_performance_data, data.player_season_average_performance_data);
        initializeRadarChart(data.player_match_performance_data, data.player_season_average_performance_data);

        // Update performance chart
        console.log('Updating performance chart with:', data.performance_data, data.average_player_performance_data, data.player_name);
        updatePerformanceChart(data.performance_data, data.average_player_performance_data, data.player_name);

        // Update stats dropdown data
        console.log('Updating stats data with:', data.stats_data);
        updateStatsData(data.stats_data);
      })
      .catch(error => {
        console.error('Error fetching player stats:', error);
      });
    }

    function updatePerformanceChart(playerData, teamData, playerName) {
      const chartContainer = document.getElementById('chart-content');

      // Create canvas if it doesn't exist
      let canvas = chartContainer.querySelector('#performanceChart');
      if (!canvas) {
        canvas = document.createElement('canvas');
        canvas.id = 'performanceChart';
        canvas.width = 400;
        canvas.height = 220;
        chartContainer.innerHTML = '';
        chartContainer.appendChild(canvas);
      }

      const ctx = canvas.getContext('2d');

      if (performanceChart) {
        performanceChart.destroy();
      }

      performanceChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: Object.keys(playerData),
          datasets: [{
            label: playerName,
            data: Object.values(playerData),
            backgroundColor: '#4dc9f6'
          }, {
            label: 'Team Average',
            data: Object.values(teamData),
            backgroundColor: '#f72585'
          }]
        },
        options: {
          responsive: true,
          plugins: {
            tooltip: {
              enabled: false
            },
            legend: {
              labels: {
                color: 'white'
              }
            }
          },
          scales: {
            x: {
              grid: {
                color: 'rgba(255, 255, 255, 0.1)'
              },
              ticks: {
                color: 'white'
              }
            },
            y: {
              grid: {
                color: 'rgba(255, 255, 255, 0.1)'
              },
              ticks: {
                color: 'white'
              }
            }
          }
        }
      });
    }

    function updateStatsData(statsData) {
      console.log('updateStatsData called with:', statsData);
      console.log('Stats data keys:', Object.keys(statsData || {}));
      window.currentStatsData = statsData;

      // Update the stats list if a dropdown option is selected
      const statsDropdown = document.getElementById('stats_dropdown');
      console.log('Dropdown element:', statsDropdown);
      console.log('Dropdown options count:', statsDropdown ? statsDropdown.options.length : 0);
      console.log('Dropdown value:', statsDropdown ? statsDropdown.value : 'no dropdown');

      if (statsDropdown) {
        // Force selection of first option if none selected
        if (!statsDropdown.value && statsDropdown.options.length > 0) {
          statsDropdown.value = statsDropdown.options[0].value;
          console.log('Set dropdown to first option:', statsDropdown.value);
        }

        if (statsDropdown.value) {
          console.log('Calling updateStatsList with:', statsDropdown.value);
          console.log('Data for selected stat:', statsData[statsDropdown.value]);
          updateStatsList(statsDropdown.value);
        }
      } else {
        console.error('Stats dropdown not found!');
      }
    }

    // Stats dropdown functionality
    const statsDropdown = document.getElementById('stats_dropdown');
    const statsContainer = document.getElementById('stats_container');

    function updateStatsList(selectedStat) {
      console.log('updateStatsList called with:', selectedStat);
      console.log('window.currentStatsData:', window.currentStatsData);

      const players = (window.currentStatsData && window.currentStatsData[selectedStat]) || [];
      console.log('Players for', selectedStat, ':', players);

      if (!statsContainer) {
        console.error('Stats container not found');
        return;
      }

      console.log('Stats container found:', statsContainer);

      // Clear existing content
      statsContainer.innerHTML = '';
      console.log('Cleared container');

      if (players.length === 0) {
        console.log('No players data, showing no data message');
        statsContainer.innerHTML = '<div class="text-muted">No data available</div>';
        return;
      }

      // Create stats list
      let html = '';
      players.forEach((player, index) => {
        html += `
          <div class="d-flex justify-content-between align-items-center mb-2 text-white">
            <span>${index + 1}º - ${player.name}</span>
            <span class="stat-value fw-bold">${player.value}</span>
          </div>
        `;
      });

      console.log('Generated HTML:', html);
      statsContainer.innerHTML = html;
      console.log('Updated container innerHTML');
    }

    // Handle stats dropdown changes
    if (statsDropdown) {
      statsDropdown.addEventListener('change', function() {
        updateStatsList(this.value);
      });

      // Initialize with first option when stats data is available
      if (window.currentStatsData && statsDropdown.value) {
        updateStatsList(statsDropdown.value);
      }
    }

    // Handle player selection changes
    document.getElementById('playerSelector').addEventListener('change', function() {
      const playerId = this.value;
      updatePlayerStats(playerId);
    });
  });
</script>
