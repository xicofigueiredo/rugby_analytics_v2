<div class="notes-container">
  <div class="row">
    <!-- Top row with two equal columns -->
    <div class="col-md-6 mb-4">
      <!-- Match Coach Notes -->
      <div class="note-section h-100">
        <h6 class="text-white mb-3">COACH TEAM NOTES</h6>
        <div class="note-card h-100">
          <% if match.coach_notes.present? %>
            <p class="note-text"><%= match.coach_notes %></p>
          <% else %>
            <p class="note-text text-secondary">No match notes from coach</p>
          <% end %>
          <% if current_user&.admin? %>
            <div class="note-actions">
              <%= link_to "Edit Match Notes", edit_match_path(match, anchor: 'coach_notes'),
                  class: "btn btn-sm btn-outline-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-6 mb-4">
      <!-- Player-specific Coach Notes -->
      <%# add here the form %>

      <div class="note-section h-100">
        <h6 class="text-white mb-3">COACH NOTES TO YOU</h6>
        <div class="note-card h-100">
          <% if @player_match.coach_notes.present? %>
            <p class="note-text"><%= @player_match.coach_notes %></p>
          <% else %>
            <p class="note-text text-secondary">No match notes to you from coach</p>
          <% end %>

        </div>
      </div>
    </div>

    <!-- Full width bottom row -->
    <div class="col-md-12">
      <!-- Player Self Notes -->
      <div class="note-section">
        <br>
        <h6 class="text-white mb-3">MY NOTES</h6>
        <div class="note-card h-100">
          <%
            # Find the current user's player_match record for this match
            current_player_match = match.player_matches.find_by(player_id: current_user.player_id) if current_user.player_id.present?
          %>
          <% if current_player_match %>
            <%= form_with model: current_player_match, url: update_player_match_match_path(match, current_player_match),
                local: false, class: "player-notes-form h-100",
                id: "player-notes-form-#{current_player_match.id}" do |form| %>
              <div class="form-group flex-grow-1">
                <%= form.text_area :player_notes,
                    class: "form-control player-notes-textarea",
                    placeholder: "Enter your personal notes for this match...",
                    rows: 4,
                    id: "player_notes_#{current_player_match.id}",
                    data: {
                      player_match_id: current_player_match.id,
                      match_id: match.id,
                      autosave: true
                    } %>
              </div>
              <div class="save-status" id="player-save-status-#{current_player_match.id}"></div>
            <% end %>
          <% else %>
            <p class="note-text text-secondary">You are not registered for this match</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.notes-container {
  padding: 1rem;
}

.note-section {
  margin-bottom: 2rem;
}

.note-section h6 {
  font-size: 0.8rem;
  letter-spacing: 1px;
  opacity: 0.8;
}

.note-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  padding: 1rem;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.note-header {
  margin-bottom: 0.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.note-text {
  color: #fff;
  margin-bottom: 1rem;
  white-space: pre-wrap;
  flex-grow: 1;
}

.note-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: auto;
}

.player-notes-form {
  display: flex;
  flex-direction: column;
}

.player-notes-textarea {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #fff;
  resize: vertical;
  min-height: 100px;
  transition: all 0.3s ease;
}

.player-notes-textarea:focus {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.4);
  color: #fff;
  box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.1);
  outline: none;
}

.player-notes-textarea::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.save-status {
  font-size: 0.8rem;
  margin-top: 0.5rem;
  text-align: right;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.save-status.saving {
  color: #ffc107;
  opacity: 1;
}

.save-status.saved {
  color: #28a745;
  opacity: 1;
}

.save-status.error {
  color: #dc3545;
  opacity: 1;
}

@media (max-width: 768px) {
  .note-cards-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('Player notes auto-save script loaded');
  const textareas = document.querySelectorAll('[data-autosave="true"]');
  console.log('Found textareas:', textareas.length);

  textareas.forEach(function(textarea) {
    let saveTimeout;
    const playerMatchId = textarea.dataset.playerMatchId;
    const matchId = textarea.dataset.matchId;
    let statusElement;

    // Determine if this is a coach notes or player notes textarea
    if (playerMatchId) {
      // Player notes
      statusElement = document.getElementById(`player-save-status-${playerMatchId}`);
      console.log('Setting up player notes auto-save for player_match:', playerMatchId);
    } else {
      // Coach notes (existing functionality)
      statusElement = document.getElementById(`save-status-${matchId}`);
      console.log('Setting up coach notes auto-save for match:', matchId);
    }

    function showStatus(message, className) {
      console.log('Status:', message, className);
      if (statusElement) {
        statusElement.textContent = message;
        statusElement.className = `save-status ${className}`;

        if (className === 'saved') {
          setTimeout(() => {
            statusElement.classList.remove('saved');
          }, 2000);
        }
      }
    }

    function saveNotes() {
      console.log('Attempting to save notes');
      console.log('Notes content:', textarea.value);

      // Get CSRF token
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      console.log('CSRF token found:', !!csrfToken);

      const formData = new FormData();
      let url;

      if (playerMatchId) {
        // Player notes
        formData.append('player_match[player_notes]', textarea.value);
        formData.append('_method', 'PATCH');
        url = `/matches/${matchId}/update_player_match/${playerMatchId}`;
        console.log('Saving player notes to:', url);
      } else {
        // Coach notes (existing functionality)
        formData.append('match[coach_notes]', textarea.value);
        formData.append('_method', 'PATCH');
        url = `/matches/${matchId}`;
        console.log('Saving coach notes to:', url);
      }

      if (csrfToken) {
        formData.append('authenticity_token', csrfToken.getAttribute('content'));
      }

      showStatus('Saving...', 'saving');

      fetch(url, {
        method: 'POST',
        body: formData,
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        }
      })
      .then(response => {
        console.log('Response status:', response.status);
        console.log('Response ok:', response.ok);

        if (response.ok) {
          return response.json();
        } else {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
      })
      .then(data => {
        console.log('Save response:', data);
        if (data.status === 'success') {
          showStatus('Saved', 'saved');
        } else {
          throw new Error(data.errors ? data.errors.join(', ') : 'Unknown error');
        }
      })
      .catch(error => {
        console.error('Error saving notes:', error);
        showStatus('Save failed', 'error');
      });
    }

    // Auto-save on blur (when clicking outside)
    textarea.addEventListener('blur', function() {
      console.log('Textarea blur event triggered');
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(saveNotes, 300);
    });

    // Also save on input with debounce (optional - saves while typing)
    textarea.addEventListener('input', function() {
      console.log('Textarea input event triggered');
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(saveNotes, 2000); // Save 2 seconds after stopping typing
    });
  });
});
</script>
