    <div class="h4 fw-bold text-white mb-0 ms-3">
      BreakDown<span class="text-danger">Lab</span>
    </div>

    <% if user_signed_in? %>
      <div class="d-flex align-items-center gap-3 me-3">
        <span class="text-white">Welcome, <%= current_user.name %></span>
        <%= button_to destroy_user_session_path,
            method: :delete,
            class: "btn btn-outline-light",
            data: {
              bs_toggle: "tooltip",
              bs_placement: "bottom",
              bs_title: "Sign Out"
            } do %>
          <i class="fas fa-sign-out-alt me-1"></i> Sign Out
        <% end %>
      </div>
    <% else %>
      <div class="me-3">
        <%= link_to new_user_session_path, class: "btn btn-outline-light" do %>
          <i class="fas fa-sign-in-alt me-1"></i> Sign In
        <% end %>
      </div>
    <% end %>
  </div>
</nav>
