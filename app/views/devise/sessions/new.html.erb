<div class="container-fluid min-vh-100 d-flex align-items-start justify-content-center pt-4">
  <div class="row w-100">
    <div class="col-12 col-md-6 col-lg-4 mx-auto">
      <div class="card login-card">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <h2 class="text-white mb-2">Welcome Back</h2>
            <p class="text-secondary">Sign in to your account</p>
          </div>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form" }) do |f| %>
            <div class="mb-3">
              <%= f.label :email, class: "form-label text-white" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg", placeholder: "Enter your email" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, class: "form-label text-white" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-lg", placeholder: "Enter your password" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="mb-4">
                <div class="form-check">
                  <%= f.check_box :remember_me, class: "form-check-input" %>
                  <%= f.label :remember_me, "Remember me", class: "form-check-label text-white" %>
                </div>
              </div>
            <% end %>

            <div class="d-grid">
              <%= f.submit "Log in", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .login-card {
    background-color: #23263a;
    border: 1px solid #3a3f5c;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .form-control {
    background-color: #2a2d47;
    border: 1px solid #3a3f5c;
    color: #ffffff;
    border-radius: 8px;
  }

  .form-control:focus {
    background-color: #2a2d47;
    border-color: #4dc9f6;
    color: #ffffff;
    box-shadow: 0 0 0 0.2rem rgba(77, 201, 246, 0.25);
  }

  .form-control::placeholder {
    color: #adb5bd;
  }

  .form-label {
    font-weight: 500;
    margin-bottom: 8px;
  }

  .form-check-input:checked {
    background-color: #4dc9f6;
    border-color: #4dc9f6;
  }

  .form-check-input:focus {
    border-color: #4dc9f6;
    box-shadow: 0 0 0 0.2rem rgba(77, 201, 246, 0.25);
  }

  .btn-primary {
    background-color: #dc3545;
    border-color: #dc3545;
    border-radius: 8px;
    font-weight: 500;
    padding: 12px;
  }

  .btn-primary:hover {
    background-color: #c82333;
    border-color: #c82333;
  }

  .btn-primary:focus {
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.5);
  }

  /* Mobile optimizations */
  @media (max-width: 768px) {
    .container-fluid {
      padding: 20px;
    }

    .login-card {
      margin: 0;
    }

    .card-body {
      padding: 2rem !important;
    }
  }

  @media (max-width: 576px) {
    .card-body {
      padding: 1.5rem !important;
    }

    .form-control-lg {
      padding: 10px 12px;
      font-size: 16px; /* Prevents zoom on iOS */
    }
  }

  /* Link styling */
  .text-center a {
    color: #4dc9f6;
    text-decoration: none;
  }

  .text-center a:hover {
    color: #3bb5e6;
    text-decoration: underline;
  }
</style>
