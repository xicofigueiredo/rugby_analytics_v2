<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container">
  <div class="row mb-4">
    <div class="col-12">
      <div class="card main-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="text-white mb-0">
            <i class="fas fa-users me-2"></i>Head-to-Head Comparison
          </h4>
          <span class="text-secondary">Select up to three players to compare</span>
        </div>
        <br>
        <%= form_with url: head_to_head_path, method: :get, local: true, class: "row g-3" do |f| %>
          <% if @team_players.any? %>
            <div class="col-md-3">
              <label class="form-label text-white">Player 1</label>
              <%= f.select :player1_id,
                  options_from_collection_for_select(@team_players, :id, :name, @player1_id),
                  { include_blank: "Select Player 1" },
                  { class: "form-select", style: "background-color: #2a2a2a; color: white; border-color: #666;" } %>
            </div>

            <div class="col-md-3">
              <label class="form-label text-white">Player 2</label>
              <%= f.select :player2_id,
                  options_from_collection_for_select(@team_players, :id, :name, @player2_id),
                  { include_blank: "Select Player 2" },
                  { class: "form-select", style: "background-color: #2a2a2a; color: white; border-color: #666;" } %>
            </div>

            <div class="col-md-3">
              <label class="form-label text-white">Player 3</label>
              <%= f.select :player3_id,
                  options_from_collection_for_select(@team_players, :id, :name, @player3_id),
                  { include_blank: "Select Player 3" },
                  { class: "form-select", style: "background-color: #2a2a2a; color: white; border-color: #666;" } %>
            </div>

            <div class="col-md-3">
              <label class="form-label text-white">&nbsp;</label>
              <%= f.submit "Compare", class: "btn btn-primary w-100" %>
            </div>
          <% else %>
            <div class="col-12">
              <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>
                No players found in your team. Please contact an administrator to add players to your team.
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @player1 && @player2 %>
    <!-- Player Cards -->
    <div class="row mb-4">
      <div class="<%= @player3.present? ? 'col-md-4' : 'col-md-6' %>">
        <div class="card main-card p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="me-3">
              <% if @player1.id == 1 %>
                <img src="<%= asset_path('eu.jpg') %>" alt="<%= @player1.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
              <% elsif @player1.id == 2 %>
                <img src="<%= asset_path('puto.png') %>" alt="<%= @player1.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
              <% else %>
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                  <i class="fas fa-user text-white"></i>
                </div>
              <% end %>
            </div>
            <div>
              <h5 class="text-white mb-1"><%= @player1.name %></h5>
              <small class="text-white"><%= @player1.positions.join(", ") %></small>
            </div>
          </div>
          <div class="row text-center">
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player1.age %></div>
              <small class="text-white">Age</small>
            </div>
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player1.height %>cm</div>
              <small class="text-white">Height</small>
            </div>
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player1.weight %>kg</div>
              <small class="text-white">Weight</small>
            </div>
          </div>
        </div>
      </div>

      <div class="<%= @player3.present? ? 'col-md-4' : 'col-md-6' %>">
        <div class="card main-card p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="me-3">
              <% if @player2.id == 1 %>
                <img src="<%= asset_path('eu.jpg') %>" alt="<%= @player2.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
              <% elsif @player2.id == 2 %>
                <img src="<%= asset_path('puto.png') %>" alt="<%= @player2.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
              <% else %>
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                  <i class="fas fa-user text-white"></i>
                </div>
              <% end %>
            </div>
            <div>
              <h5 class="text-white mb-1"><%= @player2.name %></h5>
              <small class="text-white"><%= @player2.positions.join(", ") %></small>
            </div>
          </div>
          <div class="row text-center">
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player2.age %></div>
              <small class="text-white">Age</small>
            </div>
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player2.height %>cm</div>
              <small class="text-white">Height</small>
            </div>
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player2.weight %>kg</div>
              <small class="text-white">Weight</small>
            </div>
          </div>
        </div>
      </div>

      <% if @player3.present? %>
        <div class="col-md-4">
          <div class="card main-card p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="me-3">
                <% if @player3.id == 1 %>
                  <img src="<%= asset_path('eu.jpg') %>" alt="<%= @player3.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
                <% elsif @player3.id == 2 %>
                  <img src="<%= asset_path('puto.png') %>" alt="<%= @player3.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
                <% else %>
                  <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="fas fa-user text-white"></i>
                  </div>
                <% end %>
              </div>
              <div>
                <h5 class="text-white mb-1"><%= @player3.name %></h5>
                <small class="text-white"><%= @player3.positions.join(", ") %></small>
              </div>
            </div>
            <div class="row text-center">
              <div class="col-4">
                <div class="text-info fw-bold"><%= @player3.age %></div>
                <small class="text-white">Age</small>
              </div>
              <div class="col-4">
                <div class="text-info fw-bold"><%= @player3.height %>cm</div>
                <small class="text-white">Height</small>
              </div>
              <div class="col-4">
                <div class="text-info fw-bold"><%= @player3.weight %>kg</div>
                <small class="text-white">Weight</small>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Combined Radar Chart -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card main-card p-4">
          <h5 class="text-white mb-3">Skills Radar - Season Average</h5>
          <div style="height: 400px;">
            <canvas id="radarChart" width="400" height="400"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Detailed Stats Tables by Category -->
    <div class="row">
      <div class="col-12">
        <div class="card main-card p-0">
          <h5 class="text-white mb-3 p-4 pb-0">Detailed Statistics Comparison</h5>
          <div class="table-responsive">
            <%
              # Define stats organized by category based on Python rating system
              stats_by_category = {
                "Attack" => [
                  "Tries", "Assists", "Linebreak", "Linebreak Assists", "Carries With Gain",
                  "Carries Without Gain", "Conversions Made", "Conversions Missed", "Kicks Made",
                  "Kicks Missed", "Drops Made", "Drops Missed", "Mod Game Plus"
                ],
                "Defense" => [
                  "Positive Tackles", "Neutral Tackles", "Negative Tackles", "Assist Tackles",
                  "Missed Tackles", "Turnovers Won", "Lineout Steals", "Aerial Duels Won", "Aerial Duels Lost"
                ],
                "Skills" => [
                  "Offloads Good", "Offloads Bad", "Lineouts w/ Jump", "Lineouts w/o Jump",
                  "Lineout Intros Won", "Lineout Intros Lost", "Scrum Dominant"
                ],
                "Discipline" => [
                  "Total Penalties", "Offside Penalties", "Ruck Penalties", "Scrum Penalties",
                  "Other Penalties", "Yellow Cards", "Red Cards", "Knock On", "Other Mistakes"
                ],
                "Work Rate" => [
                  "Total Carries", "Total Tackles", "Mod Game Minus"
                ],
                "Consistency" => [
                  "Time Played", "Conversions Attempted", "Kicks Attempted", "Drops Attempted",
                  "Lineout Intros Total", "Total Offloads", "Total Aerial Duels", "Total Mod Game"
                ]
              }

              # Display each category
              stats_by_category.each do |category, stats|
                # Check if this category has any non-zero stats
                has_non_zero_stats = stats.any? do |stat|
                  value1 = @player1_stats[stat] || 0
                  value2 = @player2_stats[stat] || 0
                  value3 = @player3.present? ? (@player3_stats[stat] || 0) : nil
                  all_values = @player3.present? ? [value1, value2, value3] : [value1, value2]
                  !all_values.all? { |v| v == 0 }
                end

                # Skip this entire category if no stats have non-zero values
                next unless has_non_zero_stats
            %>
              <table class="table table-dark mb-3">
                <thead class="bg-danger">
                  <tr>
                    <th colspan="<%= @player3.present? ? 5 : 4 %>" class="text-white fw-bold px-3 py-3 text-center fs-5"><%= category %></th>
                  </tr>
                  <tr>
                    <th class="text-white fw-bold px-3 py-2">Statistic</th>
                    <th class="text-center text-white fw-bold px-3 py-2"><%= @player1.name %></th>
                    <th class="text-center text-white fw-bold px-3 py-2"><%= @player2.name %></th>
                    <% if @player3.present? %>
                      <th class="text-center text-white fw-bold px-3 py-2"><%= @player3.name %></th>
                    <% end %>
                    <th class="text-center text-white fw-bold px-3 py-2"><%= @player3.present? ? 'Best Performance' : 'Difference' %></th>
                  </tr>
                </thead>
                <tbody>
                  <% stats.each do |stat| %>
                    <% value1 = @player1_stats[stat] || 0 %>
                    <% value2 = @player2_stats[stat] || 0 %>
                    <% value3 = @player3.present? ? (@player3_stats[stat] || 0) : nil %>
                    <%
                      # Skip this stat if all players have 0
                      all_values = @player3.present? ? [value1, value2, value3] : [value1, value2]
                      next if all_values.all? { |v| v == 0 }
                    %>
                    <tr class="border-secondary">
                      <td class="text-white px-3 py-2"><%= stat %></td>
                      <td class="text-center text-white px-3 py-2"><%= value1 %></td>
                      <td class="text-center text-white px-3 py-2"><%= value2 %></td>
                      <% if @player3.present? %>
                        <td class="text-center text-white px-3 py-2"><%= value3 %></td>
                      <% end %>
                      <td class="text-center px-3 py-2">
                        <% if @player3.present? %>
                          <% values = { @player1.name => value1, @player2.name => value2, @player3.name => value3 } %>
                          <% sorted_values = values.sort_by { |k, v| -v } %>
                          <% best_player = sorted_values.first %>
                          <% second_best = sorted_values.length > 1 ? sorted_values[1] : nil %>

                          <% if values.values.uniq.length == 1 %>
                            <span class="text-warning">All Tied</span>
                          <% elsif second_best && best_player[1] == second_best[1] %>
                            <span class="text-warning">
                              Multiple tied for first (<%= best_player[1] %>)
                            </span>
                          <% else %>
                            <% difference = second_best ? (best_player[1] - second_best[1]) : 0 %>
                            <span style="color: <%= best_player[0] == @player1.name ? '#4dc9f6' : (best_player[0] == @player2.name ? '#f72585' : '#28a745') %>">
                              <%= best_player[0] %>
                            </span>
                            <% if difference > 0 %>
                              <br><small class="text-secondary">+<%= difference %> ahead</small>
                            <% end %>
                          <% end %>
                        <% else %>
                          <% diff = value1 - value2 %>
                          <% if diff > 0 %>
                            <span style="color: #4dc9f6"><%= @player1.name %></span>
                            <br><small class="text-secondary">+<%= diff %> ahead</small>
                          <% elsif diff < 0 %>
                            <span style="color: #f72585"><%= @player2.name %></span>
                            <br><small class="text-secondary">+<%= diff.abs %> ahead</small>
                          <% else %>
                            <span class="text-warning">Tie</span>
                          <% end %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <script>
      const ctx = document.getElementById('radarChart').getContext('2d');
      new Chart(ctx, {
        type: 'radar',
        data: {
          labels: ["Attack", "Defense", "Discipline", "Work Rate", "Skills", "Consistency"],
          datasets: [{
            label: "<%= @player1.name %>",
            data: [<%= @player1_season_avg["Attack"] %>, <%= @player1_season_avg["Defense"] %>, <%= @player1_season_avg["Work Rate"] %>, <%= @player1_season_avg["Discipline"] %>, <%= @player1_season_avg["Skills"] %>, <%= @player1_season_avg["Consistency"] %>, <%= (@player1_season_avg["Attack"] + @player1_season_avg["Defense"]) / 2 %>],
            fill: true,
            backgroundColor: '#4dc9f67a',
            borderColor: '#4dc9f6',
            pointBackgroundColor: '#4dc9f6'
          },
          {
            label: "<%= @player2.name %>",
            data: [<%= @player2_season_avg["Attack"] %>, <%= @player2_season_avg["Defense"] %>, <%= @player2_season_avg["Work Rate"] %>, <%= @player2_season_avg["Discipline"] %>, <%= @player2_season_avg["Skills"] %>, <%= @player2_season_avg["Consistency"] %>, <%= (@player2_season_avg["Attack"] + @player2_season_avg["Defense"]) / 2 %>],
            fill: true,
            backgroundColor: '#f725857a',
            borderColor: '#f72585',
            pointBackgroundColor: '#f72585'
          }<% if @player3.present? %>,
          {
            label: "<%= @player3.name %>",
            data: [<%= @player3_season_avg["Attack"] %>, <%= @player3_season_avg["Defense"] %>, <%= @player3_season_avg["Work Rate"] %>, <%= @player3_season_avg["Discipline"] %>, <%= @player3_season_avg["Skills"] %>, <%= @player3_season_avg["Consistency"] %>, <%= (@player3_season_avg["Attack"] + @player3_season_avg["Defense"]) / 2 %>],
            fill: true,
            backgroundColor: '#28a7457a',
            borderColor: '#28a745',
            pointBackgroundColor: '#28a745'
          }<% end %>]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              labels: {
                color: 'white',
                font: {
                  size: 14
                }
              }
            }
          },
          scales: {
            r: {
              min: 0,
              max: 10,
              grid: {
                color: 'rgba(255, 255, 255, 0.1)'
              },
              angleLines: {
                color: 'rgba(255, 255, 255, 0.1)'
              },
              pointLabels: {
                color: 'white',
                font: {
                  size: 14
                }
              },
              ticks: {
                display: false
              }
            }
          }
        }
      });
    </script>
  <% else %>
    <!-- Empty State -->
    <div class="row">
      <div class="col-12">
        <div class="card main-card p-5 text-center">
          <i class="fas fa-users fa-3x text-white mb-3"></i>
          <h4 class="text-white mb-3">Select Players to Compare</h4>
          <p class="text-white">Choose two or three players from your team to see a detailed comparison of their performance statistics.</p>
        </div>
      </div>
    </div>
  <% end %>
</div>
