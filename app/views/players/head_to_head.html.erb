<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container">
  <div class="row mb-4">
    <div class="col-12">
      <div class="card main-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="text-white mb-0">
            <i class="fas fa-users me-2"></i>Head-to-Head Comparison
          </h4>
          <span class="text-secondary">Select up to three players to compare</span>
        </div>
        <br>
        <%= form_with url: head_to_head_path, method: :get, local: true, class: "row g-3" do |f| %>
          <% if @team_players.any? %>
            <div class="col-md-3">
              <label class="form-label text-white">Player 1</label>
              <%= f.select :player1_id,
                  options_from_collection_for_select(@team_players, :id, :name, @player1_id),
                  { include_blank: "Select Player 1" },
                  { class: "form-select", style: "background-color: #2a2a2a; color: white; border-color: #666;" } %>
            </div>

            <div class="col-md-3">
              <label class="form-label text-white">Player 2</label>
              <%= f.select :player2_id,
                  options_from_collection_for_select(@team_players, :id, :name, @player2_id),
                  { include_blank: "Select Player 2" },
                  { class: "form-select", style: "background-color: #2a2a2a; color: white; border-color: #666;" } %>
            </div>

            <div class="col-md-3">
              <label class="form-label text-white">Player 3</label>
              <%= f.select :player3_id,
                  options_from_collection_for_select(@team_players, :id, :name, @player3_id),
                  { include_blank: "Select Player 3" },
                  { class: "form-select", style: "background-color: #2a2a2a; color: white; border-color: #666;" } %>
            </div>

            <div class="col-md-3">
              <label class="form-label text-white">&nbsp;</label>
              <%= f.submit "Compare", class: "btn btn-primary w-100" %>
            </div>
          <% else %>
            <div class="col-12">
              <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>
                No players found in your team. Please contact an administrator to add players to your team.
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @player1 && @player2 %>
    <!-- Player Cards -->
    <div class="row mb-4">
      <div class="<%= @player3.present? ? 'col-md-4' : 'col-md-6' %>">
        <div class="card main-card p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="me-3">
              <% if @player1.id == 1 %>
                <img src="<%= asset_path('eu.jpg') %>" alt="<%= @player1.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
              <% elsif @player1.id == 2 %>
                <img src="<%= asset_path('puto.png') %>" alt="<%= @player1.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
              <% else %>
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                  <i class="fas fa-user text-white"></i>
                </div>
              <% end %>
            </div>
            <div>
              <h5 class="text-white mb-1"><%= @player1.name %></h5>
              <small class="text-white"><%= @player1.positions.join(", ") %></small>
            </div>
          </div>
          <div class="row text-center">
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player1.age %></div>
              <small class="text-white">Age</small>
            </div>
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player1.height %>cm</div>
              <small class="text-white">Height</small>
            </div>
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player1.weight %>kg</div>
              <small class="text-white">Weight</small>
            </div>
          </div>
        </div>
      </div>

      <div class="<%= @player3.present? ? 'col-md-4' : 'col-md-6' %>">
        <div class="card main-card p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="me-3">
              <% if @player2.id == 1 %>
                <img src="<%= asset_path('eu.jpg') %>" alt="<%= @player2.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
              <% elsif @player2.id == 2 %>
                <img src="<%= asset_path('puto.png') %>" alt="<%= @player2.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
              <% else %>
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                  <i class="fas fa-user text-white"></i>
                </div>
              <% end %>
            </div>
            <div>
              <h5 class="text-white mb-1"><%= @player2.name %></h5>
              <small class="text-white"><%= @player2.positions.join(", ") %></small>
            </div>
          </div>
          <div class="row text-center">
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player2.age %></div>
              <small class="text-white">Age</small>
            </div>
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player2.height %>cm</div>
              <small class="text-white">Height</small>
            </div>
            <div class="col-4">
              <div class="text-info fw-bold"><%= @player2.weight %>kg</div>
              <small class="text-white">Weight</small>
            </div>
          </div>
        </div>
      </div>

      <% if @player3.present? %>
        <div class="col-md-4">
          <div class="card main-card p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="me-3">
                <% if @player3.id == 1 %>
                  <img src="<%= asset_path('eu.jpg') %>" alt="<%= @player3.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
                <% elsif @player3.id == 2 %>
                  <img src="<%= asset_path('puto.png') %>" alt="<%= @player3.name %>" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
                <% else %>
                  <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="fas fa-user text-white"></i>
                  </div>
                <% end %>
              </div>
              <div>
                <h5 class="text-white mb-1"><%= @player3.name %></h5>
                <small class="text-white"><%= @player3.positions.join(", ") %></small>
              </div>
            </div>
            <div class="row text-center">
              <div class="col-4">
                <div class="text-info fw-bold"><%= @player3.age %></div>
                <small class="text-white">Age</small>
              </div>
              <div class="col-4">
                <div class="text-info fw-bold"><%= @player3.height %>cm</div>
                <small class="text-white">Height</small>
              </div>
              <div class="col-4">
                <div class="text-info fw-bold"><%= @player3.weight %>kg</div>
                <small class="text-white">Weight</small>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Performance Comparison Chart (Bar Chart) -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card main-card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="text-white mb-0">Performance Comparison</h5>
            <span class="text-secondary">2024/2025 Season</span>
          </div>
          <div style="height: 400px;">
            <%= column_chart [
                { name: @player1.name, data: @player1_stats },
                { name: @player2.name, data: @player2_stats }
              ].concat(@player3.present? ? [{ name: @player3.name, data: @player3_stats }] : []),
              height: "350px",
              colors: @player3.present? ? ["#4dc9f6", "#f72585", "#28a745"] : ["#4dc9f6", "#f72585"],
              library: {
                plugins: {
                  legend: {
                    labels: {
                      color: 'white'
                    }
                  }
                },
                scales: {
                  x: {
                    grid: {
                      color: 'rgba(255, 255, 255, 0.1)'
                    },
                    ticks: {
                      color: 'white'
                    }
                  },
                  y: {
                    grid: {
                      color: 'rgba(255, 255, 255, 0.1)'
                    },
                    ticks: {
                      color: 'white'
                    }
                  }
                }
              } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Combined Radar Chart -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card main-card p-4">
          <h5 class="text-white mb-3">Skills Radar - Season Average</h5>
          <div style="height: 400px;">
            <canvas id="radarChart" width="400" height="400"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Detailed Stats Table -->
    <div class="row">
      <div class="col-12">
        <div class="card main-card p-4">
          <h5 class="text-white mb-3">Detailed Statistics Comparison</h5>
          <div class="table-responsive">
            <table class="table table-hover table-dark-custom">
              <thead>
                <tr>
                  <th class="text-white">Statistic</th>
                  <th class="text-center text-white"><%= @player1.name %></th>
                  <th class="text-center text-white"><%= @player2.name %></th>
                  <% if @player3.present? %>
                    <th class="text-center text-white"><%= @player3.name %></th>
                  <% end %>
                  <th class="text-center text-white"><%= @player3.present? ? 'Best Performance' : 'Difference' %></th>
                </tr>
              </thead>
              <tbody>
                <% @player1_stats.each do |stat, value1| %>
                  <% value2 = @player2_stats[stat] %>
                  <% value3 = @player3.present? ? @player3_stats[stat] : nil %>
                  <tr>
                    <td class="text-white"><%= stat %></td>
                    <td class="text-center text-white"><%= value1 %></td>
                    <td class="text-center text-white"><%= value2 %></td>
                    <% if @player3.present? %>
                      <td class="text-center text-white"><%= value3 %></td>
                    <% end %>
                    <td class="text-center">
                      <% if @player3.present? %>
                        <% values = { @player1.name => value1, @player2.name => value2, @player3.name => value3 } %>
                        <% sorted_values = values.sort_by { |k, v| -v } %>
                        <% best_player = sorted_values.first %>
                        <% second_best = sorted_values.length > 1 ? sorted_values[1] : nil %>

                        <% if values.values.uniq.length == 1 %>
                          <span class="text-warning">All Tied</span>
                        <% elsif second_best && best_player[1] == second_best[1] %>
                          <span class="text-warning">
                            Multiple tied for first (<%= best_player[1] %>)
                          </span>
                        <% else %>
                          <% difference = second_best ? (best_player[1] - second_best[1]) : 0 %>
                          <span style="color: <%= best_player[0] == @player1.name ? '#4dc9f6' : (best_player[0] == @player2.name ? '#f72585' : '#28a745') %>">
                            <%= best_player[0] %>
                          </span>
                          <% if difference > 0 %>
                            <br><small class="text-secondary">+<%= difference %> ahead</small>
                          <% end %>
                        <% end %>
                      <% else %>
                        <% diff = value1 - value2 %>
                        <% if diff > 0 %>
                          <span style="color: #4dc9f6"><%= @player1.name %></span>
                          <br><small class="text-secondary">+<%= diff %> ahead</small>
                        <% elsif diff < 0 %>
                          <span style="color: #f72585"><%= @player2.name %></span>
                          <br><small class="text-secondary">+<%= diff.abs %> ahead</small>
                        <% else %>
                          <span class="text-warning">Tie</span>
                        <% end %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <script>
      const ctx = document.getElementById('radarChart').getContext('2d');
      new Chart(ctx, {
        type: 'radar',
        data: {
          labels: ["Attack", "Defense", "Work Rate", "Discipline", "Kicking", "Set Piece", "Breakdown"],
          datasets: [{
            label: "<%= @player1.name %>",
            data: [<%= @player1_season_avg["Attack"] %>, <%= @player1_season_avg["Defense"] %>, <%= @player1_season_avg["Work Rate"] %>, <%= @player1_season_avg["Discipline"] %>, <%= @player1_season_avg["Kicking"] %>, <%= @player1_season_avg["Set Piece"] %>, <%= @player1_season_avg["Breakdown"] %>],
            fill: true,
            backgroundColor: '#4dc9f67a',
            borderColor: '#4dc9f6',
            pointBackgroundColor: '#4dc9f6'
          },
          {
            label: "<%= @player2.name %>",
            data: [<%= @player2_season_avg["Attack"] %>, <%= @player2_season_avg["Defense"] %>, <%= @player2_season_avg["Work Rate"] %>, <%= @player2_season_avg["Discipline"] %>, <%= @player2_season_avg["Kicking"] %>, <%= @player2_season_avg["Set Piece"] %>, <%= @player2_season_avg["Breakdown"] %>],
            fill: true,
            backgroundColor: '#f725857a',
            borderColor: '#f72585',
            pointBackgroundColor: '#f72585'
          }<% if @player3.present? %>,
          {
            label: "<%= @player3.name %>",
            data: [<%= @player3_season_avg["Attack"] %>, <%= @player3_season_avg["Defense"] %>, <%= @player3_season_avg["Work Rate"] %>, <%= @player3_season_avg["Discipline"] %>, <%= @player3_season_avg["Kicking"] %>, <%= @player3_season_avg["Set Piece"] %>, <%= @player3_season_avg["Breakdown"] %>],
            fill: true,
            backgroundColor: '#28a7457a',
            borderColor: '#28a745',
            pointBackgroundColor: '#28a745'
          }<% end %>]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              labels: {
                color: 'white',
                font: {
                  size: 14
                }
              }
            }
          },
          scales: {
            r: {
              min: 0,
              max: 10,
              grid: {
                color: 'rgba(255, 255, 255, 0.1)'
              },
              angleLines: {
                color: 'rgba(255, 255, 255, 0.1)'
              },
              pointLabels: {
                color: 'white',
                font: {
                  size: 14
                }
              },
              ticks: {
                display: false
              }
            }
          }
        }
      });
    </script>
  <% else %>
    <!-- Empty State -->
    <div class="row">
      <div class="col-12">
        <div class="card main-card p-5 text-center">
          <i class="fas fa-users fa-3x text-white mb-3"></i>
          <h4 class="text-white mb-3">Select Players to Compare</h4>
          <p class="text-white">Choose two or three players from your team to see a detailed comparison of their performance statistics.</p>
        </div>
      </div>
    </div>
  <% end %>
</div>
