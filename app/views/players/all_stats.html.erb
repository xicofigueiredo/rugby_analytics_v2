<div class="container">
  <div class="mb-3 d-flex justify-content-between align-items-center flex-wrap">
    <h2 class="text-white mb-0"><%= @player.name %> - All Stats</h2>
    <div class="d-flex align-items-center gap-2">
      <!-- Competition Filter -->
      <div class="btn-group" role="group">
        <%= link_to "All", all_stats_player_path(@player, competition_filter: 'all'),
            class: "btn #{@competition_filter == 'all' ? 'btn-danger' : 'btn-outline-light'}" %>
        <%= link_to "CN1", all_stats_player_path(@player, competition_filter: 'cn1'),
            class: "btn #{@competition_filter == 'cn1' ? 'btn-danger' : 'btn-outline-light'}" %>
        <%= link_to "CN2", all_stats_player_path(@player, competition_filter: 'cn2'),
            class: "btn #{@competition_filter == 'cn2' ? 'btn-danger' : 'btn-outline-light'}" %>
      </div>
      <button class="btn btn-outline-light" onclick="history.back()">
        <i class="fas fa-arrow-left me-1"></i> Back
      </button>
    </div>
  </div>

  <!-- Summary Info -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card main-card p-4">
        <div class="row text-center">
          <div class="col-md-4">
            <h5 class="text-white mb-1"><%= @total_minutes %></h5>
            <small class="text-secondary">Total Minutes Played</small>
          </div>
          <div class="col-md-4">
            <h5 class="text-white mb-1"><%= (@player_stats["Time Played"] / 80.0).round(1) rescue 0 %></h5>
            <small class="text-secondary">Matches Played (80min equiv.)</small>
          </div>
          <div class="col-md-4">
            <h5 class="text-white mb-1"><%= (@total_minutes / 80.0).round(1) rescue 0 %></h5>
            <small class="text-secondary">Full Games Equivalent</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Detailed Stats Tables by Category -->
  <div class="row">
    <div class="col-12">
      <div class="card main-card p-0">
        <h5 class="text-white mb-3 p-4 pb-0">Detailed Season Statistics <small class="text-secondary">(per 10 minutes)</small></h5>
        <div class="d-none d-lg-block">
          <div class="table-responsive">
            <%
              # Define stats organized by category based on Python rating system
              stats_by_category = {
                "Attack" => [
                  "Tries", "Assists", "Linebreak", "Linebreak Assists", "Carries With Gain",
                  "Carries Without Gain", "Conversions Made", "Conversions Missed", "Kicks Made",
                  "Kicks Missed", "Drops Made", "Drops Missed", "Game Model +", "Game Model -"
                ],
                "Defense" => [
                  "Positive Tackles", "Neutral Tackles", "Negative Tackles", "Assist Tackles",
                  "Missed Tackles", "Turnovers Won", "Lineout Steals", "Aerial Duels Won", "Aerial Duels Lost"
                ],
                "Skills" => [
                  "Offloads Good", "Offloads Bad", "Lineouts w/ Jump", "Lineouts w/o Jump",
                  "Lineout Intros Won", "Lineout Intros Lost", "Scrum Dominant"
                ],
                "Discipline" => [
                  "Total Penalties", "Offside Penalties", "Ruck Penalties", "Scrum Penalties",
                  "Other Penalties", "Yellow Cards", "Red Cards", "Knock On", "Other Mistakes"
                ],
                "Work Rate" => [
                  "Total Carries", "Total Tackles", "Game Model -"
                ],
                "Consistency" => [
                  "Time Played", "Conversions Attempted", "Kicks Attempted", "Drops Attempted",
                  "Lineout Intros Total", "Total Offloads", "Total Aerial Duels"
                ]
              }

              # Display each category
              stats_by_category.each do |category, stats|
            %>
              <table class="table table-dark mb-3">
                <thead class="bg-danger">
                  <tr>
                    <th colspan="6" class="text-white fw-bold px-3 py-3 text-center fs-5"><%= category %></th>
                  </tr>
                  <tr>
                    <th class="text-white fw-bold px-3 py-2">Stat</th>
                    <th class="text-white fw-bold px-3 py-2 text-center">Total</th>
                    <th class="text-white fw-bold px-3 py-2">Stat</th>
                    <th class="text-white fw-bold px-3 py-2 text-center">Total</th>
                    <th class="text-white fw-bold px-3 py-2">Stat</th>
                    <th class="text-white fw-bold px-3 py-2 text-center">Total</th>
                  </tr>
                </thead>
                <tbody>
                  <%
                    # Split all stats into three columns (no filtering)
                    stats_per_column = (stats.length / 3.0).ceil
                    stats_column_1 = stats[0, stats_per_column] || []
                    stats_column_2 = stats[stats_per_column, stats_per_column] || []
                    stats_column_3 = stats[stats_per_column * 2, stats_per_column] || []

                    # Create rows by combining the three columns
                    max_rows = [stats_column_1.length, stats_column_2.length, stats_column_3.length].max
                    (0...max_rows).each do |i|
                      stat1 = stats_column_1[i]
                      stat2 = stats_column_2[i]
                      stat3 = stats_column_3[i]
                  %>
                    <tr class="border-secondary">
                      <td class="text-white px-3 py-2">
                        <%= stat1 || "" %>
                      </td>
                      <td class="text-white text-center px-3 py-2">
                        <% if stat1 %>
                          <% value = @player_stats[stat1] || 0 %>
                          <% per_10min = @per_10min_stats[stat1] || 0 %>
                          <%= value %> <small class="text-secondary">(<%= per_10min %>)</small>
                        <% end %>
                      </td>
                      <td class="text-white px-3 py-2">
                        <%= stat2 || "" %>
                      </td>
                      <td class="text-white text-center px-3 py-2">
                        <% if stat2 %>
                          <% value = @player_stats[stat2] || 0 %>
                          <% per_10min = @per_10min_stats[stat2] || 0 %>
                          <%= value %> <small class="text-secondary">(<%= per_10min %>)</small>
                        <% end %>
                      </td>
                      <td class="text-white px-3 py-2">
                        <%= stat3 || "" %>
                      </td>
                      <td class="text-white text-center px-3 py-2">
                        <% if stat3 %>
                          <% value = @player_stats[stat3] || 0 %>
                          <% per_10min = @per_10min_stats[stat3] || 0 %>
                          <%= value %> <small class="text-secondary">(<%= per_10min %>)</small>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
          </div>
        </div>

        <!-- Mobile-friendly card layout -->
        <div class="d-lg-none">
          <%
            # Define stats organized by category based on Python rating system
            stats_by_category = {
              "Attack" => [
                "Tries", "Assists", "Linebreak", "Linebreak Assists", "Carries With Gain",
                "Carries Without Gain", "Conversions Made", "Conversions Missed", "Kicks Made",
                "Kicks Missed", "Drops Made", "Drops Missed", "Game Model +", "Game Model -"
              ],
              "Defense" => [
                "Positive Tackles", "Neutral Tackles", "Negative Tackles", "Assist Tackles",
                "Missed Tackles", "Turnovers Won", "Lineout Steals", "Aerial Duels Won", "Aerial Duels Lost"
              ],
              "Skills" => [
                "Offloads Good", "Offloads Bad", "Lineouts w/ Jump", "Lineouts w/o Jump",
                "Lineout Intros Won", "Lineout Intros Lost", "Scrum Dominant"
              ],
              "Discipline" => [
                "Total Penalties", "Offside Penalties", "Ruck Penalties", "Scrum Penalties",
                "Other Penalties", "Yellow Cards", "Red Cards", "Knock On", "Other Mistakes"
              ],
              "Work Rate" => [
                "Total Carries", "Total Tackles", "Game Model -"
              ],
              "Consistency" => [
                "Time Played", "Conversions Attempted", "Kicks Attempted", "Drops Attempted",
                "Lineout Intros Total", "Total Offloads", "Total Aerial Duels"
              ]
            }

            # Display each category
            stats_by_category.each do |category, stats|
          %>
            <div class="mobile-category mb-4">
              <h6 class="text-white bg-danger p-3 mb-0 text-center"><%= category %></h6>
              <div class="row g-2 p-3">
                <% stats.each do |stat_name| %>
                  <div class="col-6">
                    <div class="mobile-stat-card">
                      <div class="stat-name"><%= stat_name %></div>
                      <div class="stat-value">
                        <% value = @player_stats[stat_name] || 0 %>
                        <% per_10min = @per_10min_stats[stat_name] || 0 %>
                        <%= value %> <small class="text-secondary">(<%= per_10min %>)</small>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <br>
  <br>
</div>

<style>
  .main-card {
    background-color: #23263a;
    border: 1px solid #3a3f5c;
    border-radius: 8px;
  }

  .table-dark {
    background-color: #23263a;
    border-color: #3a3f5c;
  }

  .table-dark th {
    background-color: #2a2d47;
    border-color: #3a3f5c;
  }

  .table-dark td {
    border-color: #3a3f5c;
  }

  .bg-danger {
    background-color: #dc3545 !important;
  }

  .bg-success {
    background-color: #198754 !important;
  }

  /* Mobile-specific styles */
  .mobile-category {
    border: 1px solid #3a3f5c;
    border-radius: 8px;
    overflow: hidden;
  }

  .mobile-stat-card {
    background-color: #2a2d47;
    border: 1px solid #3a3f5c;
    border-radius: 6px;
    padding: 12px;
    text-align: center;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .stat-name {
    font-size: 0.8rem;
    color: #adb5bd;
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .stat-value {
    font-size: 1.1rem;
    font-weight: bold;
    color: #ffffff;
  }

  /* Responsive adjustments */
  @media (max-width: 576px) {
    .mobile-stat-card {
      padding: 8px;
    }

    .stat-name {
      font-size: 0.75rem;
    }

    .stat-value {
      font-size: 1rem;
    }
  }
</style>
